---META---
{"title": "Registrar visita", "h": 1000, "maxw": 1100, "ctx": "{ module: 'clientes', active: 'visita', crumbs: [{ label: 'Inicio', href: 'Main.dc.html' }, { label: 'Clientes', href: 'Clientes-Resumen.dc.html' }, { label: 'Registrar visita' }] }", "state": "{ code: '', done: [] }"}
---CONTENT---
<div>
<h1 style="margin: 0; font-size: 26px; font-weight: 800; font-family: {{T.head}}">Registrar visita</h1>
<p style="margin: 6px 0 0; color: {{T.muted}}">Introduce el número de socio del cliente para registrar su visita de hoy.</p>
</div>

<section aria-label="Registrar visita" style="{{T.card}}; padding: 28px">
<form onSubmit="{{submit}}" style="display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap">
<label style="flex: 1 1 320px"><span style="{{T.label}}">Nº de socio</span><input type="text" inputmode="numeric" autocomplete="off" value="{{code}}" onChange="{{onCode}}" placeholder="Ej. 1100008" style="{{T.input}}; height: 60px; font-size: 24px; font-weight: 700; letter-spacing: .04em"></label>
<button type="submit" style="{{T.btnP}}; height: 60px; padding: 0 28px; font-size: 17px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"></path></svg>Registrar visita</button>
</form>
<sc-if value="{{hasLast}}" hint-placeholder-val="{{ false }}">
<div role="status" style="margin-top: 20px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 16px 18px; border-radius: {{T.R}}px; background: {{T.accentSoft}}">
<span style="width: 40px; height: 40px; border-radius: 50%; background: {{T.accent}}; color: {{T.onAccent}}; display: flex; align-items: center; justify-content: center; flex-shrink: 0"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
<span style="flex-grow: 1; display: flex; flex-direction: column; gap: 2px"><strong style="font-size: 16px">Visita registrada · {{last.name}}</strong><span style="color: {{T.muted}}">Nº de socio {{last.id}} · {{last.visits}}</span></span>
<a href="Clientes-Ficha.dc.html" style="{{T.btn}}">Ver ficha</a>
</div>
</sc-if>
</section>

<section aria-labelledby="hoy" style="{{T.card}}; overflow: hidden">
<div style="{{sectionHead}}; display: flex; justify-content: space-between; align-items: center"><h2 id="hoy" style="{{h2}}">Visitas registradas hoy</h2><span style="font-size: 13px; color: {{T.muted}}">{{doneCount}}</span></div>
<sc-if value="{{noneToday}}" hint-placeholder-val="{{ true }}">
<div style="{{empty}}"><strong style="color: {{T.text}}">Todavía no hay visitas hoy</strong><span>Las visitas que registres aparecerán aquí.</span></div>
</sc-if>
<sc-if value="{{someToday}}" hint-placeholder-val="{{ false }}">
<div role="table" aria-label="Visitas de hoy">
<div role="row" style="display: grid; grid-template-columns: 100px 140px minmax(0, 1fr) 140px"><div role="columnheader" style="{{th}}">Hora</div><div role="columnheader" style="{{th}}">Nº de socio</div><div role="columnheader" style="{{th}}">Nombre</div><div role="columnheader" style="{{th}}">Visitas</div></div>
<sc-for list="{{done}}" as="vis" hint-placeholder-count="2">
<div role="row" style="display: grid; grid-template-columns: 100px 140px minmax(0, 1fr) 140px"><div role="cell" style="{{td}}">{{vis.time}}</div><div role="cell" style="{{td}}">{{vis.id}}</div><div role="cell" style="{{td}}; font-weight: 700">{{vis.name}}</div><div role="cell" style="{{td}}">{{vis.visits}}</div></div>
</sc-for>
</div>
</sc-if>
</section>
---VALS---
      const MEMBERS = { '1100008': ['水谷 友洋', 2], '1100028': ['十倉テスト 十倉テスト', 0], '1100022': ['坂本 綾花', 0], '1100007': ['ゲスト', 0] };
      const last = s.done[0] || null;
      return {
        code: s.code,
        onCode: (e) => set({ code: e.target.value }),
        submit: (e) => {
          if (e && e.preventDefault) e.preventDefault();
          const id = (this.state.code || '').trim() || '1100008';
          const m = MEMBERS[id] || ['[NOMBRE DEL CLIENTE]', 0];
          const now = new Date();
          const time = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
          set({ code: '', done: [{ id, name: m[0], visits: (m[1] + 1) + ' visitas', time }].concat(this.state.done) });
        },
        hasLast: !!last, last: last || { name: '', id: '', visits: '' },
        done: s.done, someToday: s.done.length > 0, noneToday: s.done.length === 0,
        doneCount: s.done.length === 1 ? '1 visita' : s.done.length + ' visitas'
      };
