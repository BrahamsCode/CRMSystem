---META---
{"title": "Nuevo cliente", "h": 3100, "maxw": 1280, "ctx": "{ module: 'clientes', active: 'nuevo', crumbs: [{ label: 'Inicio', href: 'Main.dc.html' }, { label: 'Clientes', href: 'Clientes-Resumen.dc.html' }, { label: 'Nuevo cliente' }] }", "state": "{ step: 'form', ptype: 'persona' }"}
---CONTENT---
<div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap">
<div>
<h1 style="margin: 0; font-size: 26px; font-weight: 800; font-family: {{T.head}}">Nuevo cliente</h1>
<p style="margin: 6px 0 0; color: {{T.muted}}">Los campos marcados con <span style="color: {{T.req}}; font-weight: 700">*</span> son obligatorios.</p>
</div>
<ol aria-label="Pasos" style="list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; flex-wrap: wrap">
<sc-for list="{{steps}}" as="st" hint-placeholder-count="3">
<li style="display: flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border-radius: 999px; background: {{st.bg}}; color: {{st.fg}}; font-size: 13px; font-weight: 700"><span style="width: 24px; height: 24px; border-radius: 50%; background: {{st.dotBg}}; color: {{st.dotFg}}; display: flex; align-items: center; justify-content: center; font-size: 12px">{{st.n}}</span>{{st.label}}</li>
</sc-for>
</ol>
</div>

<sc-if value="{{isConfirm}}" hint-placeholder-val="{{ false }}">
<div role="status" style="padding: 14px 18px; border-radius: {{T.R}}px; background: {{T.accentSoft}}; color: {{T.text}}"><strong>Revisa los datos.</strong> Si todo está correcto, pulsa «Confirmar registro». Para cambiar algo, vuelve a editar.</div>
</sc-if>
<sc-if value="{{isDone}}" hint-placeholder-val="{{ false }}">
<div role="status" style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 14px 18px; border-radius: {{T.R}}px; background: {{T.accentSoft}}; color: {{T.text}}">
<span style="width: 36px; height: 36px; border-radius: 50%; background: {{T.accent}}; color: {{T.onAccent}}; display: flex; align-items: center; justify-content: center; flex-shrink: 0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
<span style="flex-grow: 1"><strong>Cliente registrado.</strong> Nº de socio 1100029.</span>
<a href="Clientes-Ficha.dc.html" style="{{T.btn}}">Ver ficha</a>
<button type="button" onClick="{{again}}" style="{{T.btnP}}">Registrar otro</button>
</div>
</sc-if>

<div class="split" style="display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: {{T.gap}}px; align-items: start">
<nav class="idx" aria-label="Secciones del formulario" style="position: sticky; top: 88px; display: flex; flex-direction: column; gap: 2px">
<sc-for list="{{idx}}" as="x" hint-placeholder-count="6">
<a href="{{x.href}}" style="display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 0 10px; border-radius: {{T.r}}px; text-decoration: none; color: {{T.muted}}; font-weight: 600"><span style="width: 24px; height: 24px; border-radius: 50%; background: {{T.surface2}}; color: {{T.text}}; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800">{{x.n}}</span>{{x.label}}</a>
</sc-for>
</nav>

<form aria-label="Datos del nuevo cliente" style="display: flex; flex-direction: column; gap: {{T.gap}}px; min-width: 0">
<fieldset disabled="{{locked}}" style="border: 0; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: {{T.gap}}px">

<section id="cliente" aria-labelledby="h1s" style="{{T.card}}; scroll-margin-top: 80px">
<div style="{{sectionHead}}"><h2 id="h1s" style="{{h2}}">1. Datos del cliente</h2></div>
<div class="g2" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; padding: 20px 22px">
<div><span style="{{T.label}}">Nº de socio</span><div style="{{T.input}}; display: flex; align-items: center; background: {{T.surface2}}; font-weight: 700">1100029</div></div>
<label><span style="{{T.label}}">Nº de gestión</span><input type="text" style="{{T.input}}"></label>
<fieldset style="border: 0; margin: 0; padding: 0; min-width: 0; grid-column: 1 / -1"><legend style="{{T.label}}">Persona / empresa <span style="color: {{T.req}}">*</span></legend><div style="display: flex; gap: 8px; flex-wrap: wrap">
<label style="{{choice}}"><input type="radio" name="ptype" checked="{{isPersona}}" onChange="{{setPersona}}" style="accent-color: {{T.accent}}; margin: 0">Persona</label>
<label style="{{choice}}"><input type="radio" name="ptype" checked="{{isEmpresa}}" onChange="{{setEmpresa}}" style="accent-color: {{T.accent}}; margin: 0">Empresa</label>
</div></fieldset>
<label><span style="{{T.label}}">Apellido (fonético)</span><input type="text" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Nombre (fonético)</span><input type="text" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Apellido</span><input type="text" autocomplete="family-name" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Nombre</span><input type="text" autocomplete="given-name" style="{{T.input}}"></label>

<div style="grid-column: 1 / -1; padding-top: 6px; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: {{T.faint}}">Dirección</div>
<label><span style="{{T.label}}">Código postal</span><span style="display: flex; gap: 8px"><input type="text" inputmode="numeric" autocomplete="postal-code" style="{{T.input}}"><button type="button" style="{{T.btn}}; height: {{T.ctrlH}}px">Buscar dirección</button></span></label>
<label><span style="{{T.label}}">Prefectura</span><select style="{{T.input}}"><option>Selecciona…</option><option>[PREFECTURAS]</option></select></label>
<label><span style="{{T.label}}">Ciudad / distrito</span><input type="text" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Calle y número</span><input type="text" autocomplete="street-address" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Edificio / depto.</span><input type="text" style="{{T.input}}"></label>

<div style="grid-column: 1 / -1; padding-top: 6px; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: {{T.faint}}">Contacto</div>
<label><span style="{{T.label}}">Teléfono</span><input type="tel" autocomplete="tel" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Fax</span><input type="tel" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Email 1</span><input type="email" autocomplete="email" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Email 2</span><input type="email" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Personal asignado</span><select style="{{T.input}}"><option>Selecciona…</option><option>[PERSONAL]</option></select></label>
<div><span style="{{T.label}}">Referido por</span><button type="button" style="{{T.btn}}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14zM21 21l-4.3-4.3"></path></svg>Buscar socio</button></div>
</div>
</section>

<section id="personal" aria-labelledby="h2s" style="{{T.card}}; scroll-margin-top: 80px">
<div style="{{sectionHead}}"><h2 id="h2s" style="{{h2}}">2. Datos personales</h2></div>
<div class="g2" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; padding: 20px 22px">
<fieldset style="border: 0; margin: 0; padding: 0; min-width: 0"><legend style="{{T.label}}">Fecha de nacimiento</legend><div style="display: flex; gap: 8px; align-items: center"><input type="number" aria-label="Año" placeholder="Año" style="{{T.input}}; width: 100px"><input type="number" aria-label="Mes" placeholder="Mes" style="{{T.input}}; width: 76px"><input type="number" aria-label="Día" placeholder="Día" style="{{T.input}}; width: 76px"></div></fieldset>
<fieldset style="border: 0; margin: 0; padding: 0; min-width: 0"><legend style="{{T.label}}">Sexo</legend><div style="display: flex; gap: 8px; flex-wrap: wrap">
<label style="{{choice}}"><input type="radio" name="sex" style="accent-color: {{T.accent}}; margin: 0">Hombre</label>
<label style="{{choice}}"><input type="radio" name="sex" style="accent-color: {{T.accent}}; margin: 0">Mujer</label>
<label style="{{choice}}"><input type="radio" name="sex" style="accent-color: {{T.accent}}; margin: 0">Sin especificar</label>
</div></fieldset>
<label><span style="{{T.label}}">Grupo sanguíneo</span><select style="{{T.input}}"><option>—</option><option>A</option><option>B</option><option>O</option><option>AB</option></select></label>
<label><span style="{{T.label}}">Teléfono móvil</span><input type="tel" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Email personal</span><input type="email" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Ocupación</span><select style="{{T.input}}"><option>Selecciona…</option><option>[OCUPACIONES]</option></select></label>
<div style="grid-column: 1 / -1; padding-top: 6px; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: {{T.faint}}">Lugar de trabajo</div>
<label><span style="{{T.label}}">Nombre (fonético)</span><input type="text" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Nombre</span><input type="text" autocomplete="organization" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Rubro</span><select style="{{T.input}}"><option>Selecciona…</option><option>[RUBROS]</option></select></label>
<div></div>
<label><span style="{{T.label}}">Teléfono</span><input type="tel" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Fax</span><input type="tel" style="{{T.input}}"></label>
</div>
</section>

<section id="promo" aria-labelledby="h3s" style="{{T.card}}; scroll-margin-top: 80px">
<div style="{{sectionHead}}"><h2 id="h3s" style="{{h2}}">3. Información de promoción</h2></div>
<div class="g2" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; padding: 20px 22px">
<fieldset style="border: 0; margin: 0; padding: 0; min-width: 0"><legend style="{{T.label}}">Newsletter</legend><div style="display: flex; gap: 8px; flex-wrap: wrap">
<label style="{{choice}}"><input type="radio" name="news" checked style="accent-color: {{T.accent}}; margin: 0">Enviar</label>
<label style="{{choice}}"><input type="radio" name="news" style="accent-color: {{T.accent}}; margin: 0">No enviar</label>
<label style="{{choice}}"><input type="radio" name="news" style="accent-color: {{T.accent}}; margin: 0">No entregable</label>
</div></fieldset>
<label><span style="{{T.label}}">Tipo de dirección</span><select style="{{T.input}}"><option>—</option><option>[TIPOS DE DIRECCIÓN]</option></select></label>
<fieldset style="border: 0; margin: 0; padding: 0; min-width: 0"><legend style="{{T.label}}">Recordatorio de reservas por email</legend><div style="display: flex; gap: 8px; flex-wrap: wrap">
<label style="{{choice}}"><input type="radio" name="remind" checked style="accent-color: {{T.accent}}; margin: 0">Enviar</label>
<label style="{{choice}}"><input type="radio" name="remind" style="accent-color: {{T.accent}}; margin: 0">No enviar</label>
</div></fieldset>
<label><span style="{{T.label}}">Grupo de cliente</span><select style="{{T.input}}"><option>Sin grupo</option><option>[GRUPOS]</option></select></label>
<label><span style="{{T.label}}">Motivo de primera visita</span><select style="{{T.input}}"><option>Selecciona…</option><option>たまたまきた</option></select></label>
<div></div>
<label style="grid-column: 1 / -1"><span style="{{T.label}}">Notas</span><textarea rows="3" style="{{T.input}}; height: auto; padding: 10px 12px; resize: vertical"></textarea></label>
</div>
</section>

<section id="familia" aria-labelledby="h4s" style="{{T.card}}; scroll-margin-top: 80px">
<div style="{{sectionHead}}"><h2 id="h4s" style="{{h2}}">4. Información familiar</h2></div>
<div class="g2" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; padding: 20px 22px">
<label><span style="{{T.label}}">Cónyuge <span style="color: {{T.req}}">*</span></span><select required style="{{T.input}}"><option>Selecciona…</option><option>[OPCIONES]</option></select></label>
<fieldset style="border: 0; margin: 0; padding: 0; min-width: 0"><legend style="{{T.label}}">Aniversario de boda <span style="color: {{T.req}}">*</span></legend><div style="display: flex; gap: 8px; align-items: center"><input type="number" aria-label="Año" placeholder="Año" style="{{T.input}}; width: 100px"><input type="number" aria-label="Mes" placeholder="Mes" style="{{T.input}}; width: 76px"><input type="number" aria-label="Día" placeholder="Día" style="{{T.input}}; width: 76px"></div></fieldset>
</div>
</section>

<section id="mascota" aria-labelledby="h5s" style="{{T.card}}; scroll-margin-top: 80px">
<div style="{{sectionHead}}; display: flex; align-items: center; gap: 10px; flex-wrap: wrap"><h2 id="h5s" style="{{h2}}">5. Mascota</h2><span style="padding: 2px 10px; border-radius: 999px; background: {{T.accentSoft}}; color: {{T.accentSoftFg}}; font-size: 12px; font-weight: 700">Formulario personalizado</span></div>
<div class="g3" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 20px; padding: 20px 22px">
<label><span style="{{T.label}}">Nombre</span><input type="text" style="{{T.input}}"></label>
<label><span style="{{T.label}}">Tipo</span><select style="{{T.input}}"><option>Selecciona…</option><option>[OPCIONES]</option></select></label>
<label><span style="{{T.label}}">Peso</span><span style="display: flex; align-items: center; gap: 8px"><input type="number" style="{{T.input}}"><span>Kg</span></span></label>
</div>
</section>

<section id="acceso" aria-labelledby="h6s" style="{{T.card}}; scroll-margin-top: 80px">
<div style="{{sectionHead}}"><h2 id="h6s" style="{{h2}}">6. Acceso a Mi página</h2><p style="margin: 4px 0 0; font-size: 13px; color: {{T.muted}}">Datos con los que el cliente entra en su Mi página.</p></div>
<div class="g2" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; padding: 20px 22px">
<div><span style="{{T.label}}">ID de acceso</span><div style="{{T.input}}; display: flex; align-items: center; background: {{T.surface2}}; font-weight: 700">1100029</div></div>
<label><span style="{{T.label}}">Contraseña <span style="color: {{T.req}}">*</span></span><span style="display: flex; gap: 8px"><input type="text" value="2545" style="{{T.input}}"><button type="button" style="{{T.btn}}; height: {{T.ctrlH}}px">Generar otra</button></span></label>
</div>
</section>
</fieldset>

<div style="position: sticky; bottom: 16px; z-index: 4; display: flex; align-items: center; justify-content: flex-end; gap: 8px; flex-wrap: wrap; padding: 12px; {{T.card}}; box-shadow: 0 10px 28px rgba(16,24,40,.14)">
<sc-if value="{{isForm}}" hint-placeholder-val="{{ true }}">
<a href="Clientes-Resumen.dc.html" style="{{T.btn}}">Cancelar</a>
<button type="button" onClick="{{toConfirm}}" style="{{T.btnP}}">Revisar y confirmar</button>
</sc-if>
<sc-if value="{{isConfirm}}" hint-placeholder-val="{{ false }}">
<button type="button" onClick="{{toForm}}" style="{{T.btn}}">Volver a editar</button>
<button type="button" onClick="{{toDone}}" style="{{T.btnP}}">Confirmar registro</button>
</sc-if>
<sc-if value="{{isDone}}" hint-placeholder-val="{{ false }}">
<a href="Clientes-Ficha.dc.html" style="{{T.btn}}">Ver ficha</a>
<button type="button" onClick="{{again}}" style="{{T.btnP}}">Registrar otro cliente</button>
</sc-if>
</div>
</form>
</div>
---VALS---
      const top = () => { try { window.scrollTo({ top: 0, behavior: 'smooth' }); } catch (e) {} };
      const ORDER = ['form', 'confirm', 'done'];
      const cur = ORDER.indexOf(s.step);
      return {
        steps: [['Datos', 0], ['Confirmación', 1], ['Registrado', 2]].map(([label, i]) => {
          const on = i === cur, past = i < cur;
          return { label, n: past ? '✓' : i + 1, bg: on ? T.accentSoft : 'transparent', fg: on ? T.accentSoftFg : T.muted, dotBg: on || past ? T.accent : T.surface2, dotFg: on || past ? T.onAccent : T.muted };
        }),
        idx: [['cliente', 'Datos del cliente'], ['personal', 'Datos personales'], ['promo', 'Promoción'], ['familia', 'Familia'], ['mascota', 'Mascota'], ['acceso', 'Acceso a Mi página']].map(([id, label], i) => ({ href: '#' + id, label, n: i + 1 })),
        isForm: s.step === 'form', isConfirm: s.step === 'confirm', isDone: s.step === 'done', locked: s.step !== 'form',
        isPersona: s.ptype === 'persona', isEmpresa: s.ptype === 'empresa',
        setPersona: () => set({ ptype: 'persona' }), setEmpresa: () => set({ ptype: 'empresa' }),
        toConfirm: () => { set({ step: 'confirm' }); top(); }, toForm: () => set({ step: 'form' }),
        toDone: () => { set({ step: 'done' }); top(); }, again: () => { set({ step: 'form' }); top(); }
      };
