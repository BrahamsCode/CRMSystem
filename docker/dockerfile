# syntax=docker/dockerfile:1
# Apache + mod_php, igual que en producción (PHP 8.2)
FROM php:8.2-apache

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Node 20 y npm copiados de la imagen oficial (sin repositorios externos)
COPY --from=node:20-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:20-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# El instalador se monta solo durante el build (no queda en la imagen)
# y borra automáticamente las dependencias de compilación.
RUN --mount=type=bind,from=mlocati/php-extension-installer:2,source=/usr/bin/install-php-extensions,target=/usr/local/bin/install-php-extensions \
    install-php-extensions pdo_pgsql pgsql pdo_mysql intl zip gd opcache pcntl exif bcmath imagick \
    # Herramientas: utilidades, cliente de PostgreSQL, ImageMagick,
    # optimizadores de imagen, msmtp para el correo y zona horaria
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        vim git curl zip unzip \
        postgresql-client \
        imagemagick \
        jpegoptim optipng pngquant gifsicle \
        msmtp \
        tzdata \
    && ln -snf /usr/share/zoneinfo/Asia/Tokyo /etc/localtime \
    && echo "Asia/Tokyo" > /etc/timezone \
    # Correo: PHP envía con msmtp al contenedor mailpit (SMTP en el puerto 1025)
    && printf 'account default\nhost mailpit\nport 1025\nfrom noreply@localhost\nauth off\ntls off\n' > /etc/msmtprc \
    && printf 'sendmail_path = "/usr/bin/msmtp -t"\n' > /usr/local/etc/php/conf.d/mail.ini \
    # Usuario 1000 para evitar problemas de permisos con los archivos montados
    && groupadd -g 1000 apache \
    && useradd -u 1000 -g apache -ms /bin/bash apache \
    && a2enmod rewrite headers \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/*

ENV TZ=Asia/Tokyo \
    APACHE_RUN_USER=apache \
    APACHE_RUN_GROUP=apache

WORKDIR /var/www
