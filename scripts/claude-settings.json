{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "crossSessionInbound": "accept",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(php *)",
      "Bash(php85 *)",
      "Bash(composer *)",
      "Bash(composer85 *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(bash scripts/en-docker.sh *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(docker run *)",
      "Bash(docker exec crmsystem2-*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git worktree list*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(rm *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(curl http://localhost*)",
      "Bash(curl http://127.0.0.1*)"
    ],
    "ask": [],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git worktree remove *)",
      "Bash(rm -rf *)",
      "Read(**/env-legacy.example)",
      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Read(**/*.backup)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  }
}
