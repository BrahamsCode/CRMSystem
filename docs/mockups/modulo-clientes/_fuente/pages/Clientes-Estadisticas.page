---META---
{"title": "Estadísticas de clientes", "h": 1500, "maxw": 1280, "ctx": "{ module: 'clientes', active: 'stats', crumbs: [{ label: 'Inicio', href: 'Main.dc.html' }, { label: 'Clientes', href: 'Clientes-Resumen.dc.html' }, { label: 'Estadísticas' }] }", "state": "{ tipo: 'rubro' }"}
---CONTENT---
<div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap">
<div>
<h1 style="margin: 0; font-size: 26px; font-weight: 800; font-family: {{T.head}}">Estadísticas de clientes</h1>
<p style="margin: 6px 0 0; color: {{T.muted}}">Clientes registrados por sexo, edad y año de alta.</p>
</div>
<button type="button" style="{{T.btn}}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"></path></svg>Exportar CSV</button>
</div>

<section aria-label="Condiciones" style="{{T.card}}; padding: 18px 20px; display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap">
<fieldset style="border: 0; margin: 0; padding: 0; min-width: 0"><legend style="{{T.label}}">Agrupar por</legend><div style="display: flex; gap: 6px">
<sc-for list="{{tipos}}" as="tp" hint-placeholder-count="2"><button type="button" aria-pressed="{{tp.on}}" onClick="{{tp.pick}}" style="{{tp.style}}">{{tp.label}}</button></sc-for>
</div></fieldset>
<fieldset style="border: 0; margin: 0; padding: 0; min-width: 0; flex: 1 1 360px"><legend style="{{T.label}}">Periodo</legend><div style="display: flex; align-items: center; gap: 8px"><input type="date" aria-label="Desde" style="{{T.input}}"><span style="color: {{T.faint}}">hasta</span><select aria-label="Duración" style="{{T.input}}"><option>Selecciona…</option><option>1 semana</option><option>[OTROS PERIODOS]</option></select></div><span style="display: block; margin-top: 6px; font-size: 12px; color: {{T.faint}}">Ejemplo: desde 2009/01/01, una semana.</span></fieldset>
<button type="button" style="{{T.btnP}}">Aplicar</button>
</section>

<section aria-labelledby="tot" style="{{T.card}}; padding: 22px">
<div style="display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap"><h2 id="tot" style="{{h2}}">Total de clientes</h2><span style="font-size: 40px; font-weight: 800; font-family: {{T.head}}">16</span><span style="color: {{T.muted}}">clientes</span></div>
<div role="img" aria-label="{{sexAria}}" style="display: flex; height: 28px; margin-top: 14px; border-radius: {{T.r}}px; overflow: hidden; gap: 2px">
<sc-for list="{{sexSeg}}" as="sg" hint-placeholder-count="3"><div title="{{sg.tip}}" style="width: {{sg.pct}}%; background: {{sg.color}}; color: {{sg.ink}}; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700">{{sg.label}}</div></sc-for>
</div>
<div style="display: flex; gap: 18px; flex-wrap: wrap; margin-top: 10px; font-size: 13px">
<sc-for list="{{sexSeg}}" as="sl" hint-placeholder-count="3"><span style="display: inline-flex; align-items: center; gap: 8px"><span style="width: 12px; height: 12px; border-radius: 3px; background: {{sl.color}}"></span>{{sl.name}} <strong>{{sl.n}}</strong></span></sc-for>
</div>

<div class="split" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: {{T.gap}}px; margin-top: 22px">
<sc-for list="{{ageBlocks}}" as="ab" hint-placeholder-count="2">
<div style="border: 1px solid {{T.border}}; border-radius: {{T.R}}px; padding: 18px">
<div style="display: flex; align-items: baseline; gap: 10px"><span style="width: 12px; height: 12px; border-radius: 3px; background: {{ab.color}}"></span><h3 style="margin: 0; font-size: 15px; font-weight: 700">{{ab.title}}</h3><span style="font-size: 22px; font-weight: 800">{{ab.total}}</span><span style="color: {{T.muted}}; font-size: 13px">por edad</span></div>
<div role="img" aria-label="{{ab.aria}}" style="display: flex; height: 22px; margin-top: 12px; border-radius: {{T.r}}px; overflow: hidden; gap: 2px">
<sc-for list="{{ab.seg}}" as="as" hint-placeholder-count="4"><div title="{{as.tip}}" style="width: {{as.pct}}%; background: {{as.color}}; color: {{as.ink}}; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; white-space: nowrap; overflow: hidden">{{as.label}}</div></sc-for>
</div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px 12px; margin-top: 12px; font-size: 13px">
<sc-for list="{{ab.legend}}" as="al" hint-placeholder-count="9"><span style="display: flex; align-items: center; gap: 8px; color: {{al.fg}}"><span style="width: 10px; height: 10px; border-radius: 2px; background: {{al.color}}; flex-shrink: 0"></span>{{al.name}} <strong>{{al.n}}</strong></span></sc-for>
</div>
</div>
</sc-for>
</div>
<p style="margin: 14px 0 0; font-size: 12px; color: {{T.faint}}">Sin especificar: clientes sin sexo registrado. «Otros»: sin fecha de nacimiento o fuera de los rangos.</p>
</section>

<section aria-labelledby="yr" style="{{T.card}}; overflow: hidden">
<div style="{{sectionHead}}"><h2 id="yr" style="{{h2}}">Altas por año</h2><p style="margin: 4px 0 0; font-size: 13px; color: {{T.muted}}">Últimos 5 años, del 1 de enero al 31 de diciembre.</p></div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr))">
<sc-for list="{{years}}" as="yy" hint-placeholder-count="5">
<div style="padding: 18px 20px; border-top: 1px solid {{T.border}}; border-right: 1px solid {{T.border}}; display: flex; flex-direction: column; gap: 10px">
<div style="display: flex; justify-content: space-between; align-items: baseline"><strong style="font-size: 16px">{{yy.year}}</strong><span><span style="font-size: 24px; font-weight: 800">{{yy.total}}</span> <span style="color: {{T.muted}}; font-size: 13px">altas</span></span></div>
<sc-if value="{{yy.has}}" hint-placeholder-val="{{ true }}">
<div role="img" aria-label="{{yy.aria}}" style="display: flex; height: 14px; border-radius: 999px; overflow: hidden; gap: 2px"><sc-for list="{{yy.seg}}" as="ys" hint-placeholder-count="2"><div title="{{ys.tip}}" style="width: {{ys.pct}}%; background: {{ys.color}}"></div></sc-for></div>
<div style="display: flex; flex-direction: column; gap: 4px; font-size: 13px"><sc-for list="{{yy.lines}}" as="yl" hint-placeholder-count="2"><span style="display: flex; align-items: center; gap: 8px"><span style="width: 10px; height: 10px; border-radius: 2px; background: {{yl.color}}"></span>{{yl.text}}</span></sc-for></div>
</sc-if>
<sc-if value="{{yy.none}}" hint-placeholder-val="{{ false }}"><span style="font-size: 13px; color: {{T.faint}}">Sin altas este año.</span></sc-if>
</div>
</sc-for>
</div>
</section>
---VALS---
      const dark = T.dark;
      const SEX = { h: ['Hombre', dark ? '#6AA5F0' : '#2F6FD6'], m: ['Mujer', dark ? '#F28CA5' : '#D94C70'], x: ['Sin especificar', dark ? '#6B7280' : '#A3ABB9'] };
      const ink = (c) => (c === SEX.x[1] && !dark ? '#14171F' : '#FFFFFF');
      const seg = (parts, total) => parts.filter((p) => p.n > 0).map((p) => { const pct = Math.floor((p.n / total) * 100); return { ...p, pct, label: pct >= 12 ? pct + ' %' : '', tip: p.name + ': ' + p.n + ' (' + pct + ' %)', ink: ink(p.color) }; });
      const sexParts = [{ name: SEX.h[0], n: 9, color: SEX.h[1] }, { name: SEX.m[0], n: 3, color: SEX.m[1] }, { name: SEX.x[0], n: 4, color: SEX.x[1] }];
      const AGES = ['10s', '20s', '30s', '40s', '50s', '60s', '70s', '80s'];
      const ramp = (hue, i) => 'hsl(' + hue + ', ' + (dark ? 70 : 65) + '%, ' + (dark ? 78 - i * 6 : 80 - i * 7) + '%)';
      const ageBlock = (title, color, hue, counts, other) => {
        const total = counts.reduce((a, b) => a + b, 0) + other;
        const parts = AGES.map((a, i) => ({ name: a.replace('s', '') + ' años', n: counts[i], color: ramp(hue, i) })).concat([{ name: 'Otros', n: other, color: SEX.x[1] }]);
        const sg = seg(parts, total).map((p) => ({ ...p, ink: '#14171F', label: p.pct >= 12 ? p.name.replace(' años', '') + ' · ' + p.pct + ' %' : '' }));
        return { title, color, total, seg: sg, aria: title + ' por edad: ' + parts.filter((p) => p.n).map((p) => p.name + ' ' + p.n).join(', '),
          legend: parts.map((p) => ({ ...p, fg: p.n ? T.text : T.faint })) };
      };
      const Y = [
        ['2022', 1, 0, 0, 'Hombres: 40 años (1)', ''],
        ['2023', 0, 0, 0, '', ''],
        ['2024', 1, 2, 0, 'Hombres: 30 años (1)', 'Mujeres: 30 años (1), otros (1)'],
        ['2025', 1, 1, 1, 'Hombres: otros (1)', 'Mujeres: 10 años (1)'],
        ['2026', 1, 0, 1, 'Hombres: 20 años (1)', '']
      ];
      return {
        tipos: [['rubro', 'Por rubro'], ['pref', 'Por prefectura']].map(([v, label]) => ({ label, on: s.tipo === v, style: s.tipo === v ? base.chipOn : base.chipOff, pick: () => set({ tipo: v }) })),
        sexSeg: seg(sexParts, 16).map((p) => ({ ...p, name: p.name })),
        sexAria: 'Total 16 clientes: hombres 9, mujeres 3, sin especificar 4',
        ageBlocks: [
          ageBlock('Hombres', SEX.h[1], 215, [0, 3, 3, 2, 0, 0, 0, 0], 1),
          ageBlock('Mujeres', SEX.m[1], 345, [1, 0, 1, 0, 0, 0, 0, 0], 1)
        ],
        years: Y.map(([year, h, m, x, lh, lm]) => {
          const total = h + m + x;
          const parts = [{ name: 'Hombres', n: h, color: SEX.h[1] }, { name: 'Mujeres', n: m, color: SEX.m[1] }, { name: 'Sin especificar', n: x, color: SEX.x[1] }];
          return { year, total, has: total > 0, none: total === 0, seg: total ? seg(parts, total) : [],
            aria: year + ': ' + total + ' altas', lines: parts.filter((p) => p.n).map((p) => ({ color: p.color, text: p.name + ' ' + p.n })).concat([lh, lm].filter(Boolean).map((t) => ({ color: 'transparent', text: t }))) };
        })
      };
