APP_NAME="CRM System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

# Textos de pantalla en japonés (lang/ja)
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=crmsystem2
DB_USERNAME=root
DB_PASSWORD=

# Señalización (BD `admin` del legacy en producción). Vacías = conexión principal, esquema `signage`
DB_SIGNAGE_HOST=
DB_SIGNAGE_PORT=
DB_SIGNAGE_DATABASE=
DB_SIGNAGE_USERNAME=
DB_SIGNAGE_PASSWORD=
# Esquema de la conexión signage: `signage` en desarrollo; con la BD `admin` real, probablemente `public`
# DB_SIGNAGE_SCHEMA=signage
# GoTel (signage/mail): destinatario del aviso de お問い合わせ; vacío = sin correo, como el legacy
SIGNAGE_CONTACT_NOTIFY=

# ビーコン (BD externa del legacy, beacon_db.php). En pausa: solo modelos. Conexión perezosa
DB_BEACON_HOST=
DB_BEACON_PORT=
DB_BEACON_DATABASE=
DB_BEACON_USERNAME=
DB_BEACON_PASSWORD=
# DB_BEACON_SSLMODE=prefer
# Segundos máximos para conectar a la BD de beacons (la app no espera más si no responde)
# DB_BEACON_TIMEOUT=5

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API de la tienda móvil y del CRM (valores reales solo en el .env del servidor)
MOBILESHOP_API_USER=
MOBILESHOP_API_PASS=
MOBILE_SHOP_EXTLINK_API_URL=
# Interruptor de extlink (sin definir = solo en producción, APP_ENV=production). Desarrollo: apagado.
# En producción quitar la línea (o poner true); vacío = apagado
MOBILESHOP_EXTLINK_ENABLED=false
MOBILESHOP_EXTLINK_PASS=
MOBILESHOP_LIST=
MOBILESHOP_PRIVATE_KEY=
MOBILESHOP_PUBLIC_KEY=
CRM_API_KEY=

# Desarrollo: nunca llamar a g-api (b.g-api.net) ni avisar al proveedor real. En producción, quitar estas líneas
# (CRM_GAPI_ENABLED vale true por defecto con APP_ENV=production; los avisos van por defecto a las direcciones del legacy).
CRM_GAPI_ENABLED=false
CRM_NOTIFY_SHOP_CREATED=support@example.com
CRM_NOTIFY_CONTACT=crm@example.com

# Núcleo (config/crm.php, NUCLEO.md §2, §4 y §9)
# `docker` = todo visitante es desarrollador (menús de mantenimiento). En producción, vacío
STAGE=
# IP de desarrollo/soporte del proveedor, separadas por comas (nucleo.maintenance, nucleo.shop-create)
CRM_DEVELOPER_IPS=
# Proxies de confianza del hosting: '*' o IP/rangos con comas. Vacío = REMOTE_ADDR, como el legacy
TRUSTED_PROXIES=
# Login de soporte (Relation / extsupport): claves internas solo en el .env del servidor
RELATION_LOGIN_PASS=
SUPPORT_MASTER_PASS=
# CRM_SUPPORT_API_HOST=b.g-api.net
# Versión que muestra システム管理 (por defecto 2.2.2; poner la del legacy en producción)
# CRM_VERSION=
# 帳票管理 (el legacy lo mostraba solo en su servidor de producción)
CRM_WORKING_REPORT=false
# PDF: carpeta de ipaexg.ttf / ipaexm.ttf (por defecto storage/fonts) y fuente por defecto (vacía = Sun-ExtA de mPDF).
# La imagen de producción ya trae IPAex en /usr/local/share/fonts/ipaex con ipaexm por defecto
# CRM_PDF_FONT_DIR=
CRM_PDF_DEFAULT_FONT=

# Solo la imagen de producción (docker-entrypoint.sh): planificador y worker de cola en el mismo contenedor
# CRM_SCHEDULER_ENABLED=true
# CRM_QUEUE_WORKER_ENABLED=false
# DB_WAIT_SECONDS=60
