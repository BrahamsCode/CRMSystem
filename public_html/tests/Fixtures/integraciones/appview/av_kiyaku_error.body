	<div style="background: #ffc1c1;  padding: 10px; color: red; margin-bottom: 10px; border: 1px solid red;">
		名前を必ず入力ください。<br>電話番号を数字のみで入力ください。<br>	</div>
	
	<form action="./member_kiyaku.php" method="post">
		<dl class="dl_list03">
			<dt>名前 <small>(必須)</small></dt>
				<dd><input type="text" name="name" value=""></dd>
			<dt>電話番号 <small>(必須)</small></dt>
				<dd><input type="text" name="tel" value="09a"></dd>
			<dt>メールアドレス</dt>
				<dd><input type="text" name="mail" value="bad"></dd>
		</dl>
		<p class="bt02">
		<input type="submit" value="登録確認">
		</p>
	</form>
	
	</main>

